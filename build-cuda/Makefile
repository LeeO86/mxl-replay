.PHONY : tests/harness/harness.s

# target to generate assembly for a file
tests/harness/harness.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/mxl-replay-harness.dir/build.make CMakeFiles/mxl-replay-harness.dir/tests/harness/harness.cpp.s
.PHONY : tests/harness/harness.cpp.s

